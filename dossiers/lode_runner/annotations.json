  "comments": {
    "627e": "parity of $1a: even -> low nibble, odd -> high nibble",
    "6283": "byte from the buffer at $0d00, two values per byte",
    "6288": "even: low nibble; BPL always jumps",
    "628c": "odd: high nibble, then on to the next byte",
    "6296": "values 10-15 are invalid: read as 0",
    "6c02": "where the player is: A = sprite, Y = y, X = hx",
    "6c05": "draw him; zp_differ: was anything under him?",
    "6c0a": "nothing under him: done",
    "6c0c": "something under him: gold he just picked up?",
    "6c10": "no: the player dies",
    "7a3e": "Y = y (0-191)",
    "7a41": "low byte, the same on both pages",
    "7a45": "high byte of the row's offset in a page",
    "7a48": "HGR1 starts at $2000",
    "7a4c": "HGR2 starts at $4000, so toggle bits 5 and 6",
    "7a50": "both row pointers set ",
    "8336": "A = sprite, Y = y, X = hx (x = 2 * hx)",
    "833a": "returns A = byte, X = shift",
    "8352": "with Y",
    "83a7": "A = sprite, Y = y, X = hx (x = 2 * hx)",
    "83ab": "returns A = byte, X = shift",
    "83b2": "the shifted sprite into zp_shifted",
    "83b5": "11 rows to draw",
    "83b9": "zp_differ = 0: nothing found under the sprite yet",
    "83bd": "shift 5 or more: 3 bytes per row",
    "83c3": "2 screen bytes per row",
    "83c5": "zp_ptr1 = row y on page 1, zp_ptr2 on page 2",
    "83ca": "page 1 XOR page 2: where the pages differ",
    "83ce": "... under the sprite's pixels ...",
    "83d2": "... is noted in zp_differ",
    "83d4": "draw: page 1 = page 1 OR sprite",
    "83dc": "the same for the 2nd byte",
    "83ee": "next row",
    "83f2": "until 11 rows are drawn",
    "83f5": "3 screen bytes per row, as in .two",
    "8438": "X = shift (0-6), zp_sprite = sprite -> zp_shifted",
    "843c": "pointer to the sprite data: row 0, 1st byte",
    "8444": "page of the shift table for this shift",
    "8447": "written into the 4 lookups below (selfmod1, 2, 5, 6)",
    "8453": "X = offset into zp_shifted",
    "8457": "this row's 1st sprite byte: 7 pixels",
    "845a": "low byte of where its shifted pixels are",
    "845d": "written into selfmod3, and +1 into selfmod4",
    "8466": "high byte of where its shifted pixels are",
    "846f": "shifted, 1st byte",
    "8474": "shifted, 2nd byte",
    "8479": "next sprite byte: 104 ($68) bytes on",
    "8486": "the same for the row's 2nd sprite byte",
    "84a3": "OR: the middle byte gets pixels from both",
    "84b9": "3 bytes on in zp_shifted",
    "84bc": "until 11 rows are done",
    "8872": "X = hx, the pixel column halved (x = 2 * hx)",
    "8875": "byte = tbl_hx_byte[hx], kept on the stack",
    "8876": "shift = tbl_hx_shift[hx]",
    "887a": "byte back into A",
    "887b": "returns A = byte, X = shift"
  }
